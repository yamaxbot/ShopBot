# Авторизация Playerok. Укажите либо полный набор cookie, либо только token.
PLAYEROK_COOKIES=
PLAYEROK_TOKEN=
PLAYEROK_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36

# Ссылки на 1–3 созданных вручную премиум-лота или их ID.
# Первый обязателен. Дополнительные поля можно оставить пустыми.
PLAYEROK_ITEM=
PLAYEROK_ITEM_2=
PLAYEROK_ITEM_3=

# Файлы и состояние.
ACCOUNTS_FILE=accaunts.txt
DATABASE_PATH=data/playerok_bot.sqlite3
LOG_PATH=logs/playerok_bot.log

# Текст для поля «Комментарий» в данных товара.
DELIVERY_COMMENT=приятного пользования

# Защита от неожиданного списания. Публикация остановится, если премиум дороже лимита.
PREMIUM_PRICE_LIMIT_RUB=50

# Бот отмечает оплаченную сделку как выполненную после фиксации выдачи.
AUTO_CONFIRM_DEAL=true

# Дополнительное сообщение в чат покупателя. Обычно не нужно, так как комментарий
# уже находится в данных товара.
SEND_COURTESY_MESSAGE=false
COURTESY_MESSAGE=приятного пользования

# Интервал проверки оплаченных сделок.
RECONCILE_SECONDS=15

# Поднятие каждого активного лота после 2 часов без покупок.
# Только с 12:00 до 00:00 МСК; время сервера не влияет на расписание.
AUTO_BUMP_ENABLED=true
AUTO_BUMP_SECONDS=7200

# Если автоматическое определение полей не сработает, впишите точные подписи из лота.
LOGIN_FIELD_LABEL=
PASSWORD_FIELD_LABEL=
COMMENT_FIELD_LABEL=
COMBINED_FIELD_LABEL=

# Telegram-хост: каждый настраивает свои Playerok и FunPay в личном чате.
# FunPay golden_key, ссылки и User-Agent вводятся через /fp_connect и /fp_items.
# Резерв Playerok: 5 запасных; FunPay: пополнение до 5 при остатке <2.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DATA_DIR=data/telegram
TELEGRAM_MAX_WORKERS=20
# Лимит одновременно работающих товарных групп всех пользователей.
# Пусто — доступен всем в личных сообщениях. Можно ограничить ID через запятую.
TELEGRAM_ALLOWED_USER_IDS=
# Администраторы: числовые Telegram ID через запятую. Доступ без подписки.
# Обязательно заполните перед приёмом оплаты. Тарифы по умолчанию: 3 дня — 20, 7 дней — 35,
# 15 дней — 70 Stars; администраторы меняют их в боте командами /set_price и /del_price.
TELEGRAM_ADMIN_IDS=
